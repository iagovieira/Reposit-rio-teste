# Site Metadata
META_TITLE=Emergency Site
META_URL=https://example.com
META_DESC=A simple emergency website
META_LANG=en
META_COLOR=#db0000
META_EMAIL=contact@example.com
META_TELEPHONE=

# Email Configuration (for Invoice System)
# SMTP settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# For Gmail:
# 1. Enable 2-factor authentication
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use the app password as SMTP_PASS

# For other providers (SendGrid, Mailgun, etc.):
# Update SMTP_HOST, SMTP_PORT according to provider documentation
